# Virtual environments & caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.duckdb_extensions/
scratch/

# Secrets & credentials (Zero-Secret Policy)
.env
.env.*
!*env.example
*credentials*.json
*service-account*.json
*.pem
*.key

# Local staging mirror of GCS lake (canonical storage is gs://operational-intelligence-crafter-lake/)
data/lake/
docs/qa/data/*.geojson
docs/qa/data/*.parquet
docs/data/workbench_bundle.json
docs/exports/
docs/map_packages/

# Authenticated GeoLibre exports (may contain signed URLs / HMAC keys)
exports/geolibre/
