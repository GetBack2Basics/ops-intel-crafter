# Operational Intelligence Crafter — Environment Configuration Template
# Copy to .env and populate secrets locally (never commit .env)

OIC_GCP_PROJECT=operational-intelligence-crafter
OIC_GCS_BUCKET=operational-intelligence-crafter-lake
OIC_STAGE_LOCAL=1
OIC_ALLOW_LOCAL_LAKE=1
OIC_LOCAL_LAKE_ROOT=data/lake

# Optional Compute & Routing Endpoints
WHEROBOTS_API_KEY=
WHEROBOTS_RUNTIME=tiny
VALHALLA_URL=http://localhost:8002
GCE_VALHALLA_INSTANCE=valhalla-tuffs
GCE_VALHALLA_ZONE=australia-southeast1-b

# Optional AI Provider Keys (Gemini / OpenRouter)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

